[
  {
    "label": "pnpm dev",
    "command": "pnpm",
    "args": ["dev"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "pnpm dev:force",
    "command": "pnpm",
    "args": ["dev:force"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "pnpm dev:setup",
    "command": "pnpm",
    "args": ["dev:setup"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "pnpm check",
    "command": "pnpm",
    "args": ["check"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "pnpm test",
    "command": "pnpm",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "pnpm test:e2e",
    "command": "pnpm",
    "args": ["test:e2e"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "pnpm lint",
    "command": "pnpm",
    "args": ["lint"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "pnpm build",
    "command": "pnpm",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
