{
  "name": "@poetry/cms-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "compile": "node ../../scripts/check-ui-catalogs.mjs project.inlang/settings.json && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "build": "pnpm compile",
    "check": "pnpm compile && tsc --noEmit",
    "test": "pnpm compile && node --test scripts/fallback.test.mjs"
  },
  "dependencies": {
    "@poetry/i18n": "workspace:*"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "typescript": "5.9.3"
  }
}
