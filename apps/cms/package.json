{
  "name": "@poetry/cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "seed:homepage": "pnpm --filter @poetry/cms-ui compile && tsx scripts/seed/seed-homepage.ts",
    "dev": "pnpm --filter @poetry/cms-ui compile && next dev --port 3001",
    "build": "pnpm --filter @poetry/cms-ui compile && next build --webpack",
    "start": "pnpm --filter @poetry/cms-ui compile && next start --port 3001",
    "check": "pnpm --filter @poetry/cms-ui compile && tsc --noEmit",
    "payload": "pnpm --filter @poetry/cms-ui compile && payload",
    "generate:types": "pnpm --filter @poetry/cms-ui compile && payload generate:types",
    "seed": "pnpm --filter @poetry/cms-ui compile && tsx scripts/seed/seed-cli.ts",
    "test": "pnpm --filter @poetry/cms-ui compile && vitest run",
    "seed:bulk": "pnpm --filter @poetry/cms-ui compile && tsx scripts/seed/seed-cli.ts --bulk",
    "seed:photos": "pnpm --filter @poetry/cms-ui compile && tsx scripts/seed/seed-cli.ts --bulk --photos"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-mcp": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@poetry/i18n": "workspace:*",
    "cross-env": "7.0.3",
    "dotenv": "16.6.1",
    "graphql": "16.11.0",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.4",
    "@poetry/cms-ui": "workspace:*"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/node": "26.6.4",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
