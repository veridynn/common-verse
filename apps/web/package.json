{
  "name": "@poetry/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/check-ui-catalogs.mjs project.inlang/settings.json && pnpm --filter @poetry/cms-ui compile && astro dev",
    "build": "node ../../scripts/check-ui-catalogs.mjs project.inlang/settings.json && pnpm --filter @poetry/cms-ui compile && astro build",
    "preview": "astro preview",
    "check": "node ../../scripts/check-ui-catalogs.mjs project.inlang/settings.json && pnpm --filter @poetry/cms-ui compile && astro check",
    "test": "pnpm compile:ui && pnpm --filter @poetry/cms-ui compile && vitest run",
    "compile:ui": "node ../../scripts/check-ui-catalogs.mjs project.inlang/settings.json && node scripts/compile-ui.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/svelte": "9.0.1",
    "@dicebear/core": "10.6.0",
    "@dicebear/styles": "10.6.0",
    "@inlang/paraglide-js": "2.25.4",
    "@payloadcms/live-preview": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@poetry/cms-ui": "workspace:*",
    "@poetry/i18n": "workspace:*",
    "@poetry/types": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "bits-ui": "2.19.3",
    "clsx": "2.1.1",
    "lucide-svelte": "1.0.1",
    "svelte": "5.57.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@inlang/plugin-m-function-matcher": "2.2.6",
    "@inlang/plugin-message-format": "4.4.4",
    "@internationalized/date": "^3.12.4",
    "shadcn-svelte": "1.7.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
