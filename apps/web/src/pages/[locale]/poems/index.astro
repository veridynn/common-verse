---
import { authorDisplayName } from '../../../lib/editorial'
import { Heading } from '$lib/components/ui/heading'
import { Eyebrow } from '$lib/components/ui/eyebrow'
import { Link } from '$lib/components/ui/link'
import { isLocale, localizedPath } from '@poetry/i18n'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getPoems } from '../../../lib/cms'
import * as m from '../../../paraglide/messages.js'

const { locale: rawLocale } = Astro.params
if (!isLocale(rawLocale)) return new Response('Not found', { status: 404 })
const locale = rawLocale
const poems = await getPoems(locale)
const title = m.nav_poems({}, { locale })
---

<BaseLayout {locale} {title} canonicalPath="poems">
  <section>
    <Eyebrow>{m.site_title({}, { locale })}</Eyebrow>
    <Heading level={1}>{title}</Heading>
    <ul class="content-list">
      {poems.map((poem) => (
        <li>
          <article>
            <Heading level={2}><Link variant="heading" href={localizedPath(locale, `poems/${poem.slug}`)}>{poem.title}</Link></Heading>
            {typeof poem.author === 'object' && poem.author && <p>{authorDisplayName(poem.author.name)}</p>}
          </article>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
