---
import { getSecret } from 'astro:env/server'
import { isLocale } from '@poetry/i18n'
import { Button } from '$lib/components/ui/button/index.js'
import { getWorkshop, getWorkshopLocales } from '../../../lib/cms'
import { mediaCredit } from '../../../lib/media-credit'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import * as m from '../../../paraglide/messages.js'

const { locale: rawLocale, slug } = Astro.params
if (!isLocale(rawLocale) || !slug) return new Response('Not found', { status: 404 })
const locale = rawLocale
const suppliedSecret = Astro.url.searchParams.get('previewSecret') ?? undefined
const previewSecret = getSecret('PREVIEW_SECRET')
const preview = Boolean(suppliedSecret && previewSecret && suppliedSecret === previewSecret)
if (suppliedSecret && !preview) return new Response('Invalid preview link', { status: 401 })
const workshop = await getWorkshop(slug, locale, preview ? suppliedSecret : undefined)
if (!workshop || !workshop.title) return new Response('Not found', { status: 404 })
const description = workshop.seo?.description ?? workshop.description ?? m.site_description({}, { locale })
const title = workshop.seo?.title ?? `${workshop.title} · ${m.site_title({}, { locale })}`
const cmsUrl = import.meta.env.PUBLIC_CMS_URL ?? 'http://localhost:3001'
const socialMedia = workshop.seo?.image && typeof workshop.seo.image === 'object' ? workshop.seo.image : null
const workshopMedia = workshop.image && typeof workshop.image === 'object' ? workshop.image : null
const credit = mediaCredit(workshopMedia?.credit)
const image = socialMedia?.url ? new URL(socialMedia.url, cmsUrl).href : workshopMedia?.url ? new URL(workshopMedia.url, cmsUrl).href : null
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: workshop.title,
  description,
  startDate: workshop.startDate,
  ...(workshop.endDate ? { endDate: workshop.endDate } : {}),
  ...(workshop.location ? { location: { '@type': 'Place', name: workshop.location } } : {}),
  ...(image ? { image: [image] } : {}),
  url: new URL(`/${locale}/workshops/${slug}`, import.meta.env.PUBLIC_SITE_URL ?? 'http://localhost:4321').href,
  eventStatus: 'https://schema.org/EventScheduled',
}
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeStyle: 'short' }).format(new Date(workshop.startDate))
const alternateLocales = await getWorkshopLocales(slug, preview ? suppliedSecret : undefined)
---

<BaseLayout {locale} {title} {description} {image} {structuredData} {alternateLocales} canonicalPath={`workshops/${slug}`} noIndex={workshop.seo?.noIndex ?? false} {preview} contentType="article">
  <article>
    <p class="eyebrow">{m.workshop_label({}, { locale })}</p>
    <h1>{workshop.title}</h1>
    {workshopMedia?.url && workshopMedia.alt && <figure class="hero-figure">
      <img class="hero-image" src={new URL(workshopMedia.url, cmsUrl).href} alt={workshopMedia.alt} width={workshopMedia.width ?? 1200} height={workshopMedia.height ?? 800} />
      {credit && <figcaption>
        {credit.source && <p>{m.demo_photo_notice({}, { locale })}</p>}
        <p dir="auto">{credit.text}</p>
        {credit.source && credit.license && <p lang="en" dir="ltr"><a href={credit.source}>Wikimedia Commons</a> · <a href={credit.license}>License</a></p>}
      </figcaption>}
    </figure>}
    <div class="content-grid">
      <div>
        {workshop.description && <p class="lede">{workshop.description}</p>}
        {workshop.content && <div class="prose">{workshop.content}</div>}
      </div>
      <aside class="meta-card" aria-label={m.workshop_label({}, { locale })}>
        <p><time datetime={workshop.startDate}>{date}</time></p>
        {workshop.location && <p>{workshop.location}</p>}
        {workshop.registrationUrl && <Button href={workshop.registrationUrl}>{m.registration({}, { locale })}</Button>}
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .hero-figure { margin: 0; }
  figcaption { margin-block: -1rem 2rem; font-size: 0.875rem; overflow-wrap: anywhere; }
  figcaption p { margin-block: 0.25rem; }
</style>
