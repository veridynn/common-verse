---
import { isLocale, localizedPath } from '@poetry/i18n'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getWorkshops } from '../../../lib/cms'
import * as m from '../../../paraglide/messages.js'

const { locale: rawLocale } = Astro.params
if (!isLocale(rawLocale)) return new Response('Not found', { status: 404 })
const locale = rawLocale
const workshops = await getWorkshops(locale)
const title = m.nav_workshops({}, { locale })
---

<BaseLayout {locale} {title}>
  <section>
    <p class="eyebrow">{m.site_title({}, { locale })}</p>
    <h1>{title}</h1>
    <ul class="content-list">
      {workshops.filter((workshop) => workshop.title).map((workshop) => (
        <li>
          <article>
            <h2><a href={localizedPath(locale, `workshops/${workshop.slug}`)}>{workshop.title}</a></h2>
            {workshop.description && <p>{workshop.description}</p>}
            <time datetime={workshop.startDate}>
              {new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(new Date(workshop.startDate))}
            </time>
          </article>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
