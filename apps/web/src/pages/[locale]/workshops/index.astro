---
import { Heading } from '$lib/components/ui/heading'
import { Eyebrow } from '$lib/components/ui/eyebrow'
import { Link } from '$lib/components/ui/link'
import { isLocale, localizedPath } from '@poetry/i18n'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getWorkshops } from '../../../lib/cms'
import * as m from '../../../paraglide/messages.js'

const { locale: rawLocale } = Astro.params
if (!isLocale(rawLocale)) return new Response('Not found', { status: 404 })
const locale = rawLocale
const workshops = await getWorkshops(locale)
const title = m.nav_workshops({}, { locale })
---

<BaseLayout {locale} {title} canonicalPath="workshops">
  <section>
    <Eyebrow>{m.site_title({}, { locale })}</Eyebrow>
    <Heading level={1}>{title}</Heading>
    <ul class="content-list">
      {workshops.filter((workshop) => workshop.title).map((workshop) => (
        <li>
          <article>
            <Heading level={2}><Link variant="heading" href={localizedPath(locale, `workshops/${workshop.slug}`)}>{workshop.title}</Link></Heading>
            {workshop.description && <p>{workshop.description}</p>}
            <time datetime={workshop.startDate}>
              {new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(new Date(workshop.startDate))}
            </time>
          </article>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
