---
import { Heading } from '$lib/components/ui/heading'
import { Text } from '$lib/components/ui/text'
import EditorialImage from '../../../components/EditorialImage.astro'
import { locationText } from '../../../lib/location'
import { Link } from '$lib/components/ui/link'
import { isLocale, localizedPath } from '@poetry/i18n'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getEvents } from '../../../lib/cms'
import * as m from '../../../paraglide/messages.js'

const { locale: rawLocale } = Astro.params
if (!isLocale(rawLocale)) return new Response('Not found', { status: 404 })
const locale = rawLocale
const events = (await getEvents(locale)).filter((event) => event.title)
const title = m.nav_events({}, { locale })
---

<BaseLayout {locale} {title} canonicalPath="events">
  <section>
    <Heading level={1}>{title}</Heading>
    <Text variant="lead">{m.events_intro({}, { locale })}</Text>
    {events.length === 0 && <p>{m.events_empty({}, { locale })}</p>}
    <ul class="content-list event-programme">
      {events.map((event) => (
        <li>
          <article>
            <EditorialImage image={event.image} {locale} />
            <div class="programme-copy">
              <p class="programme-date"><time datetime={event.startDate}>
                {new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Berlin' }).format(new Date(event.startDate))}
              </time></p>
              <Heading level={2}><Link variant="heading" href={localizedPath(locale, `events/${event.slug}`)}>{event.title}</Link></Heading>
              {event.description && <Text>{event.description}</Text>}
              {locationText(event.location) && <Text variant="small" tone="muted">{locationText(event.location)}</Text>}
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  section { overflow-wrap: anywhere; }
  .event-programme { gap: var(--space-md-lg); }
  .event-programme article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: var(--space-md-lg);
    align-items: center;
    padding-block: var(--space-md-lg);
  }
  .event-programme article:not(:has(figure)) { grid-template-columns: 1fr; }
  .programme-copy { min-inline-size: 0; }
  .programme-copy :global(h2) { margin-block: var(--space-xs) var(--space-sm); line-height: 1.2; }
  .programme-copy :global(p) { margin-block: var(--space-xs); max-inline-size: 58ch; }
  .programme-date { font-weight: 600; }
  @media (max-width: 40rem) {
    .event-programme article { grid-template-columns: 1fr; }
  }
</style>
