---
import { Heading } from '$lib/components/ui/heading'
import { Eyebrow } from '$lib/components/ui/eyebrow'
import { Link } from '$lib/components/ui/link'
import { isLocale, localizedPath } from '@poetry/i18n'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getEvents } from '../../../lib/cms'
import * as m from '../../../paraglide/messages.js'

const { locale: rawLocale } = Astro.params
if (!isLocale(rawLocale)) return new Response('Not found', { status: 404 })
const locale = rawLocale
const events = await getEvents(locale)
const title = m.nav_events({}, { locale })
---

<BaseLayout {locale} {title} canonicalPath="events">
  <section>
    <Eyebrow>{m.site_title({}, { locale })}</Eyebrow>
    <Heading level={1}>{title}</Heading>
    <ul class="content-list">
      {events.filter((event) => event.title).map((event) => (
        <li>
          <article>
            <Heading level={2}><Link variant="heading" href={localizedPath(locale, `events/${event.slug}`)}>{event.title}</Link></Heading>
            {event.description && <p>{event.description}</p>}
            <time datetime={event.startDate}>
              {new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(new Date(event.startDate))}
            </time>
          </article>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
