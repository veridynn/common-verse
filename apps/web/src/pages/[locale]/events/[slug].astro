---
import { locationText } from "../../../lib/location"
import { eventContentHTML } from '../../../lib/event-content'
import { Heading } from '$lib/components/ui/heading'
import { Link } from '$lib/components/ui/link'
import EditorialImage from '../../../components/EditorialImage.astro'
import { registrationHref } from '../../../lib/registration'
import { mediaCredit } from '../../../lib/media-credit'
import { Text } from '$lib/components/ui/text'
import * as Card from '$lib/components/ui/card'
import { getSecret } from 'astro:env/server'
import { isLocale, localizedPath } from '@poetry/i18n'
import { Button } from '$lib/components/ui/button'
import { getEvent, getEventLocales } from '../../../lib/cms'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import * as m from '../../../paraglide/messages.js'

const { locale: rawLocale, slug } = Astro.params
if (!isLocale(rawLocale) || !slug) return new Response('Not found', { status: 404 })
const locale = rawLocale
const suppliedSecret = Astro.url.searchParams.get('previewSecret') ?? undefined
const previewSecret = getSecret('PREVIEW_SECRET')
const preview = Boolean(suppliedSecret && previewSecret && suppliedSecret === previewSecret)
if (suppliedSecret && !preview) return new Response('Invalid preview link', { status: 401 })
const event = await getEvent(slug, locale, preview ? suppliedSecret : undefined)
if (!event || !event.title) return new Response('Not found', { status: 404 })
const description = event.description || m.site_description({}, { locale })
const title = `${event.title} · ${m.site_title({}, { locale })}`
const cmsUrl = import.meta.env.PUBLIC_CMS_URL ?? 'http://localhost:3001'
const eventMedia = event.image && typeof event.image === 'object' ? event.image : null
const image = eventMedia?.url ? new URL(eventMedia.url, cmsUrl).href : null
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  description,
  startDate: event.startDate,
  ...(event.location?.coordinates ? { location: { '@type': 'Place', name: locationText(event.location), ...(event.location.address ? { address: event.location.address } : {}), geo: { '@type': 'GeoCoordinates', longitude: event.location.coordinates[0], latitude: event.location.coordinates[1] } } } : {}),
  ...(image ? { image: [image] } : {}),
  url: new URL(localizedPath(locale, `events/${slug}`), import.meta.env.PUBLIC_SITE_URL ?? 'http://localhost:4321').href,
  eventStatus: 'https://schema.org/EventScheduled',
}
const html = eventContentHTML(event.content, cmsUrl)
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Berlin' }).format(new Date(event.startDate))
const registrationUrl = registrationHref(event.registrationUrl, locale)
const credit = mediaCredit(eventMedia?.credit)
const alternateLocales = await getEventLocales(slug, preview ? suppliedSecret : undefined)
---

<BaseLayout {locale} {title} {description} {image} {structuredData} {alternateLocales} canonicalPath={`events/${slug}`} {preview} contentType="article">
  <article class="event-page">
    <Link variant="standalone" class="back-link" href={localizedPath(locale, 'events')}>{m.home_all_events({}, { locale })}</Link>
    <header class="event-heading">
      <Heading level={1}>{event.title}</Heading>
      {event.description && <Text variant="lead" class="lede">{event.description}</Text>}
    </header>
    <div class="content-grid event-layout">
      <div class="event-story">
        <EditorialImage image={event.image} {locale} eager />
        {credit && <p class="image-credit">{credit.source ? <><a href={credit.source}>{credit.text}</a> / <a href={credit.license!}>Creative Commons</a></> : credit.text}</p>}
      </div>
      <Card.Root as="aside" size="sm" class="event-facts" aria-label={m.events_details({}, { locale })}>
        <Card.Header><Card.Title level={2}>{m.events_details({}, { locale })}</Card.Title></Card.Header>
        <Card.Content>
          <dl>
            <div>
              <dt>{m.events_when({}, { locale })}</dt>
              <dd><time datetime={event.startDate}>{date}</time></dd>
            </div>
            {locationText(event.location) && <div><dt>{m.events_where({}, { locale })}</dt><dd>{locationText(event.location)}</dd></div>}
          </dl>
        </Card.Content>
        {registrationUrl && <Card.Footer><Button class="registration-link" href={registrationUrl}>{m.registration({}, { locale })}</Button></Card.Footer>}
      </Card.Root>
      {html && <div class="prose rich-text event-prose" set:html={html} />}
    </div>
  </article>
</BaseLayout>

<style>
  .event-page { overflow-wrap: anywhere; }
  .back-link { margin-block-end: var(--space-md-lg); }
  .event-heading { max-inline-size: 54rem; margin-block-end: var(--space-lg-xl); }
  .event-heading :global(h1) { margin-block: var(--space-sm) var(--space-md); line-height: 1.12; }
  .event-heading :global(.lede) { max-inline-size: 55ch; margin: 0; }
  .event-layout { align-items: start; }
  .event-story { min-inline-size: 0; }
  .event-prose { min-inline-size: 0; max-inline-size: 65ch; line-height: 1.75; margin: 0; }
  .event-layout :global(.event-facts) { min-inline-size: 0; }
  .event-layout :global(.registration-link) { inline-size: 100%; white-space: normal; }
  dl { margin: 0; display: grid; gap: var(--space-md); }
  dt { font-size: var(--font-size-sm); color: var(--muted-foreground); margin-block-end: var(--space-3xs); }
  dd { margin: 0; }
  .image-credit { margin-block: var(--space-xs) 0; font-size: var(--font-size-sm); color: var(--muted-foreground); white-space: pre-line; }
  @media (min-width: 48.001rem) {
    .event-prose { grid-column: 1; }
    .event-layout :global(.event-facts) {
      grid-column: 2;
      grid-row: 1 / 3;
      position: sticky;
      inset-block-start: 8rem;
      max-block-size: calc(100dvh - 9rem);
      overflow-y: auto;
    }
  }
</style>
