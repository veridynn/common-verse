---
import { locationText } from "../../../lib/location"
import { eventContentHTML } from '../../../lib/event-content'
import { Heading } from '$lib/components/ui/heading'
import { Eyebrow } from '$lib/components/ui/eyebrow'
import { Text } from '$lib/components/ui/text'
import * as Card from '$lib/components/ui/card'
import { getSecret } from 'astro:env/server'
import { isLocale, localizedPath } from '@poetry/i18n'
import { Button } from '$lib/components/ui/button/index.js'
import { getEvent, getEventLocales } from '../../../lib/cms'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import * as m from '../../../paraglide/messages.js'

const { locale: rawLocale, slug } = Astro.params
if (!isLocale(rawLocale) || !slug) return new Response('Not found', { status: 404 })
const locale = rawLocale
const suppliedSecret = Astro.url.searchParams.get('previewSecret') ?? undefined
const previewSecret = getSecret('PREVIEW_SECRET')
const preview = Boolean(suppliedSecret && previewSecret && suppliedSecret === previewSecret)
if (suppliedSecret && !preview) return new Response('Invalid preview link', { status: 401 })
const event = await getEvent(slug, locale, preview ? suppliedSecret : undefined)
if (!event || !event.title) return new Response('Not found', { status: 404 })
const description = event.seo?.description ?? event.description ?? m.site_description({}, { locale })
const title = event.seo?.title ?? `${event.title} · ${m.site_title({}, { locale })}`
const cmsUrl = import.meta.env.PUBLIC_CMS_URL ?? 'http://localhost:3001'
const socialMedia = event.seo?.image && typeof event.seo.image === 'object' ? event.seo.image : null
const eventMedia = event.image && typeof event.image === 'object' ? event.image : null
const image = socialMedia?.url ? new URL(socialMedia.url, cmsUrl).href : eventMedia?.url ? new URL(eventMedia.url, cmsUrl).href : null
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  description,
  startDate: event.startDate,
  ...(event.endDate ? { endDate: event.endDate } : {}),
  ...(event.location?.coordinates ? { location: { '@type': 'Place', name: locationText(event.location), ...(event.location.address ? { address: event.location.address } : {}), geo: { '@type': 'GeoCoordinates', longitude: event.location.coordinates[0], latitude: event.location.coordinates[1] } } } : {}),
  ...(image ? { image: [image] } : {}),
  ...(event.kind === 'event' && typeof event.price === 'number' ? { offers: { '@type': 'Offer', price: event.price, priceCurrency: 'EUR' } } : {}),
  url: new URL(localizedPath(locale, `events/${slug}`), import.meta.env.PUBLIC_SITE_URL ?? 'http://localhost:4321').href,
  eventStatus: 'https://schema.org/EventScheduled',
}
const kindLabel = event.kind === 'event' ? m.home_event({}, { locale }) : m.workshop_label({}, { locale })
const html = eventContentHTML(event.content, cmsUrl)
const price = event.kind === 'event' && typeof event.price === 'number' ? new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR' }).format(event.price) : null
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Berlin' }).format(new Date(event.startDate))
const alternateLocales = await getEventLocales(slug, preview ? suppliedSecret : undefined)
---

<BaseLayout {locale} {title} {description} {image} {structuredData} {alternateLocales} canonicalPath={`events/${slug}`} noIndex={event.seo?.noIndex ?? false} {preview} contentType="article">
  <article>
    <Eyebrow>{kindLabel}</Eyebrow>
    <Heading level={1}>{event.title}</Heading>
    {eventMedia?.url && eventMedia.alt && <figure class="hero-figure">
      <img class="hero-image" src={new URL(eventMedia.url, cmsUrl).href} alt={eventMedia.alt} width={eventMedia.width ?? 1200} height={eventMedia.height ?? 800} />
    </figure>}
    <div class="content-grid">
      <div>
        {event.description && <Text variant="lead" class="lede">{event.description}</Text>}
        {html && <div class="prose rich-text" set:html={html} />}
      </div>
      <Card.Root as="aside" variant="accent" size="sm" class="self-start" aria-label={kindLabel}>
        <Card.Content>
        <p><time datetime={event.startDate}>{date}</time></p>
        {locationText(event.location) && <p>{locationText(event.location)}</p>}
        {price && <p>{price}</p>}
        </Card.Content>
        {event.registrationUrl && <Card.Footer><Button href={event.registrationUrl}>{m.registration({}, { locale })}</Button></Card.Footer>}
      </Card.Root>
    </div>
  </article>
</BaseLayout>

<style>
  .hero-figure { margin: 0; }
</style>
