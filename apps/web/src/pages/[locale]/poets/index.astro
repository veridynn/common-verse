---
import { Heading } from '$lib/components/ui/heading'
import { Text } from '$lib/components/ui/text'
import { Link } from '$lib/components/ui/link'
import { isLocale, localizedPath } from '@poetry/i18n'
import { getAuthors } from '../../../lib/cms'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import EditorialImage from '../../../components/EditorialImage.astro'
import * as m from '../../../paraglide/messages.js'
const { locale: rawLocale } = Astro.params
if (!isLocale(rawLocale)) return new Response('Not found', { status: 404 })
const locale = rawLocale
const authors = await getAuthors(locale)
const title = m.home_poets_heading({}, { locale })
---
<BaseLayout {locale} {title} canonicalPath="poets">
  <Heading level={1}>{title}</Heading>
  <Text variant="lead" class="lede">{m.home_poets_description({}, { locale })}</Text>
  <ul class="poet-grid">{authors.map((author) => <li><article>
    <EditorialImage image={author.portrait} {locale} />
    <Heading level={2} variant="subtitle"><Link variant="heading" href={localizedPath(locale, `poets/${author.id}`)}>{author.name}</Link></Heading>
  </article></li>)}</ul>
</BaseLayout>
<style>.poet-grid { margin-block: 3rem; }</style>
