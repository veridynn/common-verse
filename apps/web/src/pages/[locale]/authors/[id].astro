---
import PersonPortrait from '../../../components/PersonPortrait.svelte'
import { authorDisplayName } from '../../../lib/editorial'
import { Heading } from '$lib/components/ui/heading'
import { Text } from '$lib/components/ui/text'
import { Link } from '$lib/components/ui/link'
import { isLocale, localizedPath } from '@poetry/i18n'
import { getAuthor, getAuthorPoems } from '../../../lib/cms'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import * as m from '../../../paraglide/messages.js'
const { locale: rawLocale, id } = Astro.params
if (!isLocale(rawLocale) || !id) return new Response('Not found', { status: 404 })
const locale = rawLocale
const [author, poems] = await Promise.all([getAuthor(id, locale), getAuthorPoems(id, locale)])
if (!author) return new Response('Not found', { status: 404 })
---
<BaseLayout {locale} title={authorDisplayName(author.name)} canonicalPath={`authors/${id}`}>
  <article>
    <Heading level={1}>{authorDisplayName(author.name)}</Heading>
    <PersonPortrait userId={author.id} image={author.portrait} />
    {author.biography && <Text variant="lead" class="lede">{author.biography}</Text>}
    <Heading level={2}>{m.nav_poems({}, { locale })}</Heading>
    <ul class="content-list">{poems.map((poem) => <li><article>
      <Heading level={3}><Link variant="heading" href={localizedPath(locale, `poems/${poem.slug}`)}>{poem.title}</Link></Heading>
    </article></li>)}</ul>
  </article>
</BaseLayout>
