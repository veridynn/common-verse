---
import PersonPortrait from '../../../components/PersonPortrait.svelte'
import { authorDisplayName } from '../../../lib/editorial'
import { Heading } from '$lib/components/ui/heading'
import { Link } from '$lib/components/ui/link'
import { isLocale, localizedPath } from '@poetry/i18n'
import { getAuthors } from '../../../lib/cms'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import * as m from '../../../paraglide/messages.js'
const { locale: rawLocale } = Astro.params
if (!isLocale(rawLocale)) return new Response('Not found', { status: 404 })
const locale = rawLocale
const authors = await getAuthors(locale)
const title = m.home_all_authors({}, { locale })
---
<BaseLayout {locale} {title} canonicalPath="authors">
  <Heading level={1}>{title}</Heading>
  <ul class="author-grid">{authors.map((author) => <li><article>
    <PersonPortrait userId={author.id} image={author.portrait} />
    <Heading level={2} variant="subtitle"><Link variant="heading" href={localizedPath(locale, `authors/${author.id}`)}>{authorDisplayName(author.name)}</Link></Heading>
  </article></li>)}</ul>
</BaseLayout>
<style>.author-grid { margin-block: 3rem; }</style>
