---
import { Heading } from '$lib/components/ui/heading'
import { Link } from '$lib/components/ui/link'
import { localizedPath, type Locale } from '@poetry/i18n'
import type { Author, HomepageSection, Poem, Workshop } from '@poetry/types'
import { contentDirection, mediaObject, safeHref, upcomingEvents } from '../lib/homepage'
import EditorialImage from './EditorialImage.astro'
import * as m from '../paraglide/messages.js'
interface Props { sections: HomepageSection[]; authors: Author[]; events: Workshop[]; poems: Poem[]; locale: Locale }
const { sections, authors, events, poems, locale } = Astro.props
const o = { locale }
const defaults = [
  { title: m.home_write({}, o), description: m.home_write_description({}, o), url: '/workshops' },
  { title: m.home_invite({}, o), description: m.home_invite_description({}, o), url: 'https://thepoetryproject.de/bildung/schule' },
  { title: m.home_support({}, o), description: m.home_support_description({}, o), url: 'https://thepoetryproject.de/spenden' },
]
const dateFormat = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Berlin' })
---
{sections.filter((section) => section.blockType === 'introduction' || section.enabled !== false).map((section, index) => {
  const id = section.blockType === 'events' ? (sections.findIndex((entry) => entry.blockType === 'events' && entry.enabled !== false) === sections.indexOf(section) ? 'upcoming' : `upcoming-${index}`) : `home-${section.blockType}-${index}`
  const headingId = `${id}-heading`
  const selectedPoets = section.poets?.filter((author): author is Author => typeof author === 'object') ?? []
  const poets = (selectedPoets.length ? selectedPoets : authors).slice(0, 4)
  const upcoming = upcomingEvents(events, section.pinnedEvents, section.limit ?? 3)
  const links = (section.links?.length ? section.links : defaults).filter((link) => link.title && safeHref(link.url, locale))
  return <section id={id} class:list={['home-section', `section-${section.blockType}`]} aria-labelledby={headingId}>
    {section.blockType === 'introduction' && <div class:list={['introduction-layout', { 'has-image': mediaObject(section.image) }]}>
      <div>
        <Heading level={2} id={headingId}>{section.heading || m.home_about_heading({}, o)}</Heading>
        <p class="section-prose">{section.description || m.home_about_description({}, o)}</p>
        {section.linkLabel && safeHref(section.linkUrl, locale) && <a class="text-link" href={safeHref(section.linkUrl, locale)}>{section.linkLabel}</a>}
      </div>
      <EditorialImage image={section.image} {locale} />
    </div>}
    {section.blockType === 'poets' && <>
      <div class="section-heading"><div>
        <Heading level={2} id={headingId}>{section.heading || m.home_poets_heading({}, o)}</Heading>
        <p>{section.description || m.home_poets_description({}, o)}</p>
      </div><a class="text-link" href={localizedPath(locale, 'poets')}>{m.home_all_poets({}, o)}</a></div>
      {poets.length ? <ul class="poet-grid">{poets.map((author) => {
        const poem = poems.find((entry) => typeof entry.author === 'object' && String(entry.author?.id) === String(author.id))
        const translation = poem?.translations?.find((entry) => entry.language === locale)
        return <li><article>
          <EditorialImage image={author.portrait} {locale} />
          {!mediaObject(author.portrait) && <div class="poet-monogram" aria-hidden="true">{author.name.trim().charAt(0)}</div>}
          <Heading level={3}><Link variant="heading" href={localizedPath(locale, `poets/${author.id}`)}>{author.name}</Link></Heading>
          {poem && <p class="poet-excerpt" lang={translation ? locale : poem.originalLanguage === 'other' ? 'und' : poem.originalLanguage} dir={contentDirection(translation ? locale : poem.originalLanguage)}>{(translation?.text ?? poem.originalText).split('\n').slice(0, 2).join('\n')}</p>}
        </article></li>
      })}</ul> : <p class="empty-message">{m.home_no_poets({}, o)}</p>}
    </>}
    {section.blockType === 'events' && <>
      <div class="section-heading"><div>
        <Heading level={2} id={headingId}>{section.heading || m.home_events_heading({}, o)}</Heading>
        <p>{section.description || m.home_events_description({}, o)}</p>
      </div><a class="text-link" href={localizedPath(locale, 'workshops')}>{m.home_all_events({}, o)}</a></div>
      {upcoming.length ? <ul class="event-list">{upcoming.map((event) => <li><article>
        <div class="event-date"><time datetime={event.startDate}>{dateFormat.format(new Date(event.startDate))}</time></div>
        <div class="event-copy"><p class="event-kind">{event.kind === 'event' ? m.home_event({}, o) : m.workshop_label({}, o)}</p>
          <Heading level={3}><Link variant="heading" href={localizedPath(locale, `workshops/${event.slug}`)}>{event.title}</Link></Heading>
          {event.location && <p>{event.location}</p>}
          {event.description && <p>{event.description}</p>}
        </div>
        <a class="event-details" href={localizedPath(locale, `workshops/${event.slug}`)} aria-label={`${m.home_event_details({}, o)}: ${event.title}`}>{m.home_event_details({}, o)}</a>
      </article></li>)}</ul> : <p class="empty-message">{m.home_no_events({}, o)}</p>}
    </>}
    {section.blockType === 'participation' && <>
      <Heading level={2} id={headingId}>{section.heading || m.home_participation_heading({}, o)}</Heading>
      {section.description && <p class="section-prose">{section.description}</p>}
      <ul class="participation-grid">{links.map((link) => <li><Heading level={3}><a href={safeHref(link.url, locale)}>{link.title}</a></Heading><p>{link.description}</p></li>)}</ul>
    </>}
    {section.blockType === 'newsletter' && <div class="newsletter-layout">
      <div><Heading level={2} id={headingId}>{section.heading || m.home_newsletter_heading({}, o)}</Heading><p>{section.description || m.home_newsletter_description({}, o)}</p></div>
      <a class="newsletter-link" href={safeHref(section.linkUrl, locale) ?? 'https://thepoetryproject.de/newsletter'}>{section.linkLabel || m.home_newsletter_action({}, o)}</a>
    </div>}
  </section>
})}
