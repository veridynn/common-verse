---
import { Heading } from '$lib/components/ui/heading'
import { Section, AuthorCard, PoemCard, EventItem } from '$lib/components/sections'
import { localizedPath, type Locale } from '@poetry/i18n'
import type { Author, HomepageSection, Poem, Event } from '@poetry/types'
import { mediaObject, safeHref, upcomingEvents, sectionItems, featuredItem } from '../lib/homepage'
import EditorialImage from './EditorialImage.astro'
import FeaturedContent from './FeaturedContent.astro'
import * as m from '../paraglide/messages.js'
interface Props { sections: HomepageSection[]; authors: Author[]; events: Event[]; poems: Poem[]; recentPoems: Poem[]; locale: Locale; preview?: boolean }
const { sections, authors, events, poems, recentPoems, locale, preview = false } = Astro.props
const o = { locale }
---
{sections.filter((section) => section.blockType === 'introduction' || section.enabled !== false).map((section, index) => {
  const id = section.blockType === 'events' ? (sections.findIndex((entry) => entry.blockType === 'events' && entry.enabled !== false) === sections.indexOf(section) ? 'upcoming' : `upcoming-${index}`) : `home-${section.blockType}-${index}`
  const headingId = `${id}-heading`
  const selectedAuthors = sectionItems(authors, section.authors, section.selectionMode)
  const selectedPoems = sectionItems(recentPoems, section.poems, section.selectionMode, preview)
  const upcoming = upcomingEvents(events, section.pinnedEvents, section.selectionMode ? 4 : section.limit ?? 4, new Date(), section.selectionMode, preview)
  const links = (section.links ?? []).filter((link) => link.title && safeHref(link.url, locale))
  const collection = section.blockType === 'authors' ? 'authors' : section.blockType === 'poems' ? 'poems' : section.blockType === 'events' ? 'events' : undefined
  const archiveLabel = section.blockType === 'authors' ? m.home_all_authors({}, o) : section.blockType === 'poems' ? m.home_explore({}, o) : m.home_all_events({}, o)
  return <>
    {(section.blockType === 'introduction' || section.blockType === 'newsletter') ? <section id={id} class:list={['home-section', `section-${section.blockType}`]} aria-labelledby={section.heading ? headingId : undefined}>
      {!section.heading && <p class="content-unavailable" role="status">{m.home_translation_missing({}, o)}</p>}
      {section.heading && <div class:list={[section.blockType === 'introduction' ? 'introduction-layout' : 'newsletter-layout', { 'has-image': section.blockType === 'introduction' && mediaObject(section.image) }]}>
        <div><Heading level={2} id={headingId}>{section.heading}</Heading>
        {section.description && <p class="section-prose">{section.description}</p>}
        {section.blockType === 'introduction' && section.linkLabel && safeHref(section.linkUrl, locale) && <a class="text-link" href={safeHref(section.linkUrl, locale)}>{section.linkLabel}</a>}</div>
        {section.blockType === 'introduction' && <EditorialImage image={section.image} {locale} />}
        {section.blockType === 'newsletter' && section.linkLabel && safeHref(section.linkUrl, locale) && <a class="newsletter-link" href={safeHref(section.linkUrl, locale)}>{section.linkLabel}</a>}
      </div>}
    </section> : <Section {id} kind={section.blockType} heading={section.heading} description={section.description} missingMessage={m.home_translation_missing({}, o)}>
      <Fragment slot="headerAction">{collection && <a class="text-link" href={localizedPath(locale, collection)}>{archiveLabel}</a>}</Fragment>
      {section.blockType === 'featured' && (featuredItem(section, preview) ? <FeaturedContent {section} {locale} {preview} /> : <p class="empty-message">{m.home_translation_missing({}, o)}</p>)}
      {section.blockType === 'authors' && (selectedAuthors.length ? <ul class="author-grid">{selectedAuthors.map((author) => <li><AuthorCard {author} poem={poems.find((entry) => typeof entry.author === 'object' && String(entry.author?.id) === String(author.id))} {locale} /></li>)}</ul> : <p class="empty-message">{m.home_no_authors({}, o)}</p>)}
      {section.blockType === 'poems' && (selectedPoems.length ? <ul class="poem-grid">{selectedPoems.map((poem) => <li><PoemCard {poem} {locale} /></li>)}</ul> : <p class="empty-message">{m.home_no_poems({}, o)}</p>)}
      {section.blockType === 'events' && (upcoming.length ? <ul class="event-list">{upcoming.map((event) => <li><EventItem {event} {locale} /></li>)}</ul> : <p class="empty-message">{m.home_no_events({}, o)}</p>)}
      {section.blockType === 'participation' && <ul class="participation-grid">{links.map((link) => <li><Heading level={3}><a href={safeHref(link.url, locale)}>{link.title}</a></Heading>{link.description && <p>{link.description}</p>}</li>)}</ul>}
    </Section>}
  </>
})}
