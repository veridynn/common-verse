<style>
  .brand-logo {
    display: block;
    inline-size: var(--brand-logo-size, 8rem);
    aspect-ratio: 358 / 290;
    flex-shrink: 0;
  }
  .brand-logo path {
    fill: currentColor;
  }
  .brand-logo rect {
    fill: var(--brand-logo-accent, var(--primary-base));
  }
  @supports (animation-timeline: scroll(root block)) and (animation-range: 0px 160px) {
    @media (prefers-reduced-motion: no-preference) {
      :global(.site-header) .brand-logo {
        animation: compact-logo 1s linear both;
        animation-timeline: var(--header-scroll-timeline);
        animation-range: 0px 160px;
      }
    }
  }
  @keyframes compact-logo {
    from {
      inline-size: var(--brand-logo-size);
    }
    to {
      inline-size: var(--brand-logo-compact-size);
    }
  }
  @media (forced-colors: active) {
    .brand-logo path,
    .brand-logo rect {
      fill: LinkText;
      forced-color-adjust: none;
    }
  }
</style>
