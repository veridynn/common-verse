---
import { getLocaleMetadata, locales, localizedPath, type Locale } from '@poetry/i18n'
import { editorLocale, message } from '@poetry/cms-ui'
import Header from '../components/Header.astro'
import BrandLogo from '../components/BrandLogo.astro'
import * as m from '../paraglide/messages.js'
import '../styles/global.css'
import { themePreference } from '../lib/theme'

interface Props {
  locale: Locale
  title?: string
  description?: string
  image?: string | null
  canonicalPath?: string
  noIndex?: boolean
  preview?: boolean
  contentType?: 'website' | 'article'
  structuredData?: Record<string, unknown>
  alternateLocales?: readonly Locale[]
  mainClass?: string
}

const {
  locale,
  title = m.site_title({}, { locale }),
  description = m.site_description({}, { locale }),
  image,
  canonicalPath = '',
  noIndex = false,
  preview = false,
  contentType = 'website',
  structuredData,
  alternateLocales = locales,
  mainClass,
} = Astro.props
if (preview) {
  Astro.response.headers.set('Cache-Control', 'no-store')
  Astro.response.headers.set('Referrer-Policy', 'no-referrer')
}
const { direction } = getLocaleMetadata(locale)
const suppliedEditorLanguage = Astro.url.searchParams.get('editorLanguage') ?? undefined
const editorLanguage = editorLocale(suppliedEditorLanguage)
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'http://localhost:4321'
const canonical = new URL(localizedPath(locale, canonicalPath), siteUrl)
const socialImage = image ? new URL(image, siteUrl) : undefined
const xDefaultLocale = alternateLocales.includes('de') ? 'de' : (alternateLocales[0] ?? locale)
const theme = themePreference(Astro.cookies.get('poetry-theme')?.value)
---

<!doctype html>
<html lang={locale} dir={direction} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/brand/line-break/favicon.ico?v=yellow-indent" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/brand/line-break/favicon.svg?v=yellow-indent" />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex || preview ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    {alternateLocales.map((alternative) => (
      <link rel="alternate" hreflang={alternative} href={new URL(localizedPath(alternative, canonicalPath), siteUrl)} />
    ))}
    {alternateLocales.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(xDefaultLocale, canonicalPath), siteUrl)} />}
    <meta property="og:type" content={contentType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{m.skip_to_content({}, { locale })}</a>
    <Header {locale} themePreference={theme} />
    {preview && <p class="preview-banner" role="status" lang={editorLanguage} dir={getLocaleMetadata(editorLanguage).direction}>{message('draft_preview', editorLanguage)}</p>}
    {preview && <div id="payload-live-preview" data-server-url={import.meta.env.PUBLIC_CMS_URL ?? 'http://localhost:3001'} />}
    <main id="main" tabindex="-1" class={mainClass}><slot /></main>
    <footer class="site-footer"><a class="brand" href={localizedPath(locale)}><BrandLogo /><span class="sr-only">The Poetry Project{m.site_title({}, { locale }) !== 'The Poetry Project' ? ` — ${m.site_title({}, { locale })}` : ''}</span></a>
      <nav aria-label={m.home_footer({}, { locale })}>
        <a href={localizedPath(locale, "about")}>{m.home_about({}, { locale })}</a>
        <a href={localizedPath(locale, "contact")}>{m.home_contact({}, { locale })}</a>
        <a href={localizedPath(locale, "privacy")}>{m.home_privacy({}, { locale })}</a>
        <a href={localizedPath(locale, "legal")}>{m.home_legal({}, { locale })}</a>
      </nav>
      <p>© {new Date().getFullYear()} The Poetry Project e.V.</p>
    </footer>
  </body>
</html>

<script>
  import { isDocumentEvent, ready } from '@payloadcms/live-preview'
  const marker = document.getElementById('payload-live-preview')
  if (marker?.dataset.serverUrl) {
    const serverURL = new URL(marker.dataset.serverUrl).origin
    const scrollKey = `payload-preview-scroll:${window.location.pathname}`
    let savedScroll: string | null = null
    try { savedScroll = sessionStorage.getItem(scrollKey) } catch { /* Storage can be unavailable in an embedded preview. */ }
    if (savedScroll) {
      try { sessionStorage.removeItem(scrollKey) } catch { /* Preview remains usable without storage. */ }
      const position = Number(savedScroll)
      if (Number.isFinite(position)) requestAnimationFrame(() => window.scrollTo({ top: position, behavior: 'instant' }))
    }
    window.addEventListener('message', (event) => {
      if ((event.source === window.parent || event.source === window.opener) && isDocumentEvent(event, serverURL)) {
        try { sessionStorage.setItem(scrollKey, String(window.scrollY)) } catch { /* Saving scroll position is optional. */ }
        window.location.reload()
      }
    })
    ready({ serverURL })
  }
</script>
